[Unit]
Description=CloudWatcher web UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@RUN_USER@
Group=@RUN_GROUP@
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=@CONFIG_DIR@/web.env
ExecStart=@PREFIX@/venv/bin/python @PREFIX@/webapp.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
