[Unit]
Description=CloudWatcher MQTT collector
After=network-online.target mosquitto.service
Wants=network-online.target mosquitto.service

[Service]
Type=simple
User=cloudwatcher
Group=cloudwatcher
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/cloudwatcher/collector.env
ExecStart=/opt/cloudwatcher/venv/bin/python /opt/cloudwatcher/collector.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
